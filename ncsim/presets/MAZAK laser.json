{
  "version": 1,
  "name": "MAZAK laser",
  "notes": "MAZAK laser, FANUC-style program (O numbers, M98 P call, M99 return, G52 local origin per part). Technology routines as sub-program calls: M98P5001 laser on, M98P5900 laser off, M98P6004 cutting technology (Pavel 2026-10-12, Part1001orig.YNC); M23 = sensor off (Pavel). Verified on Part1001orig.YNC / Part1001.YNC. Other M-codes of this machine: teach them (they stay red).",
  "kind": "laser",
  "units": "mm",
  "lex": {
    "comments": [
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": ";",
        "close": ""
      }
    ],
    "spaces_inside_words": true,
    "line_number_letter": "N",
    "arg_separator": ","
  },
  "bounds": {
    "start_marker": "",
    "end_marker": ""
  },
