{
  "version": 1,
  "name": "FANUC",
  "notes": "FANUC-style G-code base: G00 / G01 / G02 / G03, G90 / G91, G52 local origin, O numbers \u002B M98 P calls \u002B M99, M30. The start for a machine without its own preset \u2014 teach its process commands (laser / punch on, tools) in the rows.",
  "kind": "laser",
  "units": "mm",
  "lex": {
    "comments": [
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": ";",
        "close": ""
      }
    ],
    "spaces_inside_words": true,
    "line_number_letter": "N",
    "arg_separator": ","
  },
  "bounds": {
    "start_marker": "",
    "end_marker": ""
  },
