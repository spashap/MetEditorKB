{
  "version": 1,
  "name": "TRUMPF 840D LST",
  "notes": "TRUMPF TruTops LST for Siemens 840D (punch, laser, combi). Program structure: BEGIN_PROGRAMM list - HP = main, UP = sub-programs called by their name, GEO skipped; sheet from SHEET_TECH, tool shapes from WZG_STAMM. Verified on EC_T12_60120.LST (punch, inch), AG01338.LST (punch, GEO), SRS125ISR.LST (laser, ROT RPL). Source: docs/knowledge/ncsim-presets/trumpf-lst.md (Pavel 2026-10-12 \u002B the files) and the Metalix TRUMPF customization guide.",
  "kind": "combi",
  "units": "mm",
  "lex": {
    "comments": [
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": ";",
        "close": ""
      }
    ],
    "spaces_inside_words": true,
    "line_number_letter": "N",
    "arg_separator": ","
  },
  "bounds": {
    "start_marker": "",
    "end_marker": ""
  },
